
function ini=DIACO1()
global  INT INB U V W U0 V0 W0 BDX BDY BDZ VLX VLY VLZ 
global ACX ACY ACZ FRX FRY FRZ FX FY FZ MAS MSS CN ENR
global EDG E1 E2 LI DEQB F YNGB GFRB LCRB EPRB EP SS EM
global EN KR KR1 DSS DM FS CAF DT GFR DEQ LCR TEST EST 
global DF DF1 DF2 DMP1 DMP2 TDAF CON M N L M1 N1 L1 MNL
global NNO NNS NNT NBA NBS NBT INCO NCON STEP NSTEP NDAMF
global RUN NRUN LCO TIME TTOT PSN ROH YNG EPR EPMAX EPMIN 
global MEAN  COEV ENEX ENCN ENEL ENGD ENDP ENIN DEN DERIV 
global XB YB ZB UBAR VBAR WBAR REACAOX REACAOY REACAOZ 
global STRAIN STRESS SEED 
%---------------------------------------------------
  
% !  Esta subrotina é chamada pela subrotina conecti para definir as
% !  conectividades das barras diagonais dos módulos cúbicos.
% !
%------------------------------
%       REF=NBA
%       ST(1)=0
%       ST(2)=1
%       ST(3)=M
%       ST(4)=M+1
%       ST(5)=N*M
%       ST(6)=N*M+1
%       ST(7)=N*M+M
%       ST(8)=N*M+M+1
% !
%       DO 20 K=1,L1
%       DO 20 J=1,N1
%       DO 20 I=1,M1
% !
%       NOI=(K-1)*M1*N1+(J-1)*M1+I
%       NOF=(K-1)*M*N+(J-1)*M+I
%       B=REF+(NOI-1)*8
%       NOI=NOI+MNL
% !
%       DO 10 G=1,8
%       B=B+1
%       CN(2*B-1)=NOI
%       CN(2*B)=NOF+ST(G)
%    10 CONTINUE
% !
%       NBA=NBA+8
% !
%    20 CONTINUE
!   
%
REF = NBA;
ST  = [0, 1, M, M+1, N*M, N*M+1, N*M+M, N*M+M+1];

     for K=1 : L1
     for J=1: N1
    for I=1:M1
    NOI=(K-1)*M1*N1+(J-1)*M1+I
    NOF=(K-1)*M*N+(J-1)*M+I
    B=REF+(NOI-1)*8
%       NOI=NOI+MNL
% !
%       DO 10 G=1,8
%       B=B+1
%       CN(2*B-1)=NOI
%       CN(2*B)=NOF+ST(G)
%    10 CONTINUE
% !
%       NBA=NBA+8
% !
%    20 CONTINUE




% Create index grids (I varies fastest)
[I, J, K] = ndgrid(1:M1, 1:N1, 1:L1);

% Compute all NOI and NOF at once
NOI = (K - 1) * M1 * N1 + (J - 1) * M1 + I;
NOF = (K - 1) * M * N   + (J - 1) * M   + I;

% Base pointers for all points
B = REF + (NOI - 1) * 8;
NOI = NOI + MNL;

% Expand to 8 corners
NOI_exp = repmat(NOI(:), 8, 1);
NOF_exp = repmat(NOF(:), 8, 1);
ST_exp  = repmat(ST(:), numel(NOI), 1);

B_exp = B(:) + (1:8)';  % Add 1..8 to each base pointer
B_exp = B_exp(:);

% Assign to CN
CN(2 * B_exp - 1) = NOI_exp;
CN(2 * B_exp)     = NOF_exp + ST_exp;

% Update NBA
NBA = NBA + 8 * numel(NOI);
 ini=1;
 end
