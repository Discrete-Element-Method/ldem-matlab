% !
%       STEPP=1
% !
%       DO 60 STEP = STEPP,NSTEP
% !
% !--------------------------------------------------------------------------
% !  Escreve uma informação de controle na tela em cada passo de integração
% !--------------------------------------------------------------------------
%       WRITE (*,40) STEP
% 40    FORMAT ('   STEP     ======================>  ',I7,' / ',I2)
% 
% !
% !--------------------------------------------------------------------------
% !  Controle de mudança de amortecimento
