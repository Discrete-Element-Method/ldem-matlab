
function ini=IMPERF()
global  INT INB U V W U0 V0 W0 BDX BDY BDZ VLX VLY VLZ 
global ACX ACY ACZ FRX FRY FRZ FX FY FZ MAS MSS CN ENR
global EDG E1 E2 LI DEQB F YNGB GFRB LCRB EPRB EP SS EM
global EN KR KR1 DSS DM FS CAF DT GFR DEQ LCR TEST EST 
global DF DF1 DF2 DMP1 DMP2 TDAF CON M N L M1 N1 L1 MNL
global NNO NNS NNT NBA NBS NBT INCO NCON STEP NSTEP NDAMF
global RUN NRUN LCO TIME TTOT PSN ROH YNG EPR EPMAX EPMIN 
global MEAN  COEV ENEX ENCN ENEL ENGD ENDP ENIN DEN DERIV 
global XB YB ZB UBAR VBAR WBAR REACAOX REACAOY REACAOZ 
global STRAIN STRESS SEED 
% %---------------------------------------------------
% !
%       SUBROUTINE IMPERF

% !  Esta subrotina introduz imperfeições na malha.

% !--------------------------------------------------------------------------
%       INTEGER NI,NO
% !--------------------------------------------------------------------------
%       DOUBLE PRECISION FUVW,CVUVW,UNIF,STA101
% !--------------------------------------------------------------------------
% !     GERAÇÃO DO CAMPO ALEATÓRIO PARA PERTUBAR A MALHA 
% !--------------------------------------------------------------------------
% !

% !

rng(SEED)% define the SEED of the Mesh perturbation randon field.
       LABELN=1 % The mesh perturbation is active
       LABELN=0 % inactive
       CVUVW=2.0e-2 ;% define the  variation coeficient of the mesh perturbation
    %  CUVW= 2.75D-02;
       
if LABELN == 1;
       % !
    U(1,:)=U(1,:)+randn(1,NNT)*CVUVW*LCO;
    U(2,:)=U(1,:);
    U(3,:)=U(1,:);
    V(1,:)=V(1,:)+randn(1,NNT)*CVUVW*LCO;
    V(2,:)=V(1,:);
    V(3,:)=V(1,:);
    W(1,:)=W(1,:)+randn(1,NNT)*CVUVW*LCO;
    W(2,:)=W(1,:);
    W(3,:)=W(1,:);
%         DO I=1,NNT
%           UNIF=RAN0(SEED)
%           FUVW=STA101(UNIF,1.0D-50)
%           U(1,I)=U(1,I)+FUVW*CVUVW*LCO
% 	    U(2,I)=U(1,I)
%           U(3,I)=U(1,I)
% 	    UNIF=RAN0(SEED) 
%           FUVW=STA101(UNIF,1.0D-50)
%           V(1,I)=V(1,I)+FUVW*CVUVW*LCO
% 	    V(2,I)=V(1,I)
%           V(3,I)=V(1,I)
% 	    UNIF=RAN0(SEED) 
% 	    FUVW=STA101(UNIF,1.0D-50)
%           W(1,I)=W(1,I)+FUVW*CVUVW*LCO
% 	    W(2,I)=W(1,I)
%           W(3,I)=W(1,I)
% !%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% condition to  create a border with  no perturbed mesh 
%
% Create a logical vector (mask) that is TRUE where ANY condition is satisfied
% (Equivalent to having separate IFs, as the assignments are identical)
mask = (W0 >= (L1 - 1.01) * LCO) | ...   % Condition 1
       (W0 <= (1.01 * LCO)) | ...        % Condition 2
       (U0 >= (M1 - 1.01) * LCO) | ...   % Condition 3
       (U0 <= (1.01 * LCO)) | ...        % Condition 4
       (V0 >= (N1 - 1.01) * LCO) | ...   % Condition 5
       (V0 <= (1.01 * LCO));             % Condition 6

% Apply the assignments ONLY to the columns where mask = true

% Note: This code assumes U0, V0, W0 are ROW vectors (1 x NNT).
% If they are COLUMN vectors (NNT x 1), use U0(mask).' to transpose.
    U(1, mask) = U0(mask);
    U(2, mask) = U0(mask);
    U(3, mask) = U0(mask);

    V(1, mask) = V0(mask);
    V(2, mask) = V0(mask);
    V(3, mask) = V0(mask);

    W(1, mask) = W0(mask);
    W(2, mask) = W0(mask);
    W(3, mask) = W0(mask);
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
end % here  finish  teh if 
%       DO NO=1,NNT
%         U0(NO)=U(1,NO)
%         V0(NO)=V(1,NO)
%         W0(NO)=W(1,NO)
%       END DO
U0=U(1,:);
V0=V(1,:);
W0=W(1,:);

% !
%       END IF
% 
%       RETURN
%           END
%!
  ini=1;
 end
