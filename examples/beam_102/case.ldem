# Case file generated by ldem.io.convertLegacyInput from DATA0.DAT.
# The legacy value OU2 was 9999999 (not used by ldem). If it is the number of the tracked bar, set [monitor.bar] tracked.
# Bending test (TEST 102) on the 101x41x21-module beam of the paper

format = 1                                                                     # Version of the case-file format (currently 1).
title  = "Bending test (TEST 102) on the 101x41x21-module beam of the paper"   # Free text title of the case.

[mesh]
module_size  = 3 mm            # Edge length of each cubic module. Legacy: LCO.
modules      = [100, 40, 20]   # Cubic modules along x, y and z (M N L of the legacy file count nodes: one more). Legacy: M N L.
perturbation = 0               # Random node displacement as a fraction of the module size; 0 = regular lattice.
seed         = 123             # Seed of the mesh perturbation (the random field has its own seed). Legacy: SEED.

[material]
law                 = "bilinear"   # Constitutive law of the bars.
young_modulus       = 32 GPa       # Young's modulus. Legacy: YNG.
poisson_ratio       = 0.25         # Poisson's ratio, from 0 up to less than 0.5. Legacy: PSN.
density             = 2000 kg/m3   # Mass density. Legacy: ROH.
fracture_energy     = 50 N/m       # Specific fracture energy. Legacy: GFR.
critical_distance   = 28 mm        # Equivalent (critical) distance. Legacy: DEQ.
failure_area_factor = 0.1385       # Fraction of the module face that fails per bar. Legacy: CAF.

[material.scatter]
type = "file"                    # Scatter of the critical strain: none, file (one multiplier per bar) or generated.
file = "arquivo_3lc_rnao_cv05"   # Text file with one multiplier per bar, relative to this file.

[time]
step     = 0.2 us   # Integration time step, or auto (0.9 times the critical step). Legacy: DT.
duration = 30 ms    # Total simulated time. Legacy: TTOT.

[damping]
type         = "mass_proportional"   # Damping model.
initial      = 25000 1/s             # Mass-proportional damping before switch_time. Legacy: DF1.
final        = 25000 1/s             # Mass-proportional damping after switch_time. Legacy: DF2.
switch_time  = 15 ms                 # Time at which the damping changes from initial to final. Legacy: TDAF.
constitutive = 0 s                   # Stiffness-proportional damping inside the bar law. Legacy: CON.

[scenario]
type             = "four_point_bending"   # Test case (see ldem.scenarios.registry); its other keys follow. Legacy: TEST.
loading_velocity = 0.004 m/s              # Property loadingVelocity of ldem.scenarios.FourPointBending.
support_position = 4.5 modules            # Property supportPosition of ldem.scenarios.FourPointBending.
load_position    = 33.5 modules           # Property loadPosition of ldem.scenarios.FourPointBending.

[[monitor.node]]
name = "node_1"   # Label of the node.
id   = 1          # (x, y, z) = (0, 0, 0) modules

[[monitor.node]]
name = "node_2"   # Label of the node.
id   = 2          # (x, y, z) = (1, 0, 0) modules

[[monitor.node]]
name = "node_3"   # Label of the node.
id   = 3          # (x, y, z) = (2, 0, 0) modules

[[monitor.node]]
name = "node_4"   # Label of the node.
id   = 4          # (x, y, z) = (3, 0, 0) modules

[[monitor.node]]
name = "node_5"   # Label of the node.
id   = 5          # (x, y, z) = (4, 0, 0) modules

[monitor.bar]
tracked = 7014   # Number of the bar whose strain history is stored at every step. Legacy: OU9.

[output]
folder = "output"   # Output folder, relative to the case file.
mat    = true       # Write results.mat.
ansys  = true       # Write ANSYS macro files (needs snapshots.every > 0).
vtk    = true       # Write VTK files for ParaView (needs snapshots.every > 0).

[output.snapshots]
every = 10000 steps   # Steps or time between full-field snapshots; 0 = never. Legacy: OU3.

[output.control_nodes]
every = 1 step   # Steps or time between records of the control nodes and reactions; 0 = never. Legacy: OU6.

[output.energy]
every = 1 step   # Steps or time between records of the energies; 0 = never. Legacy: OU8.
