# Case file generated by ldem.io.convertLegacyInput from DATA0.DAT.
# Example 1: beam clamped at both ends, loaded with a force at mid-span

format  = 1                                                                         # Version of the case-file format (currently 1).
title   = "Example 1: beam clamped at both ends, loaded with a force at mid-span"   # Free text title of the case.
authors = ["Rodrigo"]                                                               # Names of the authors.

[mesh]
module_size  = 1 mm         # Edge length of each cubic module. Legacy: LCO.
modules      = [5, 5, 50]   # Cubic modules along x, y and z (M N L of the legacy file count nodes: one more). Legacy: M N L.
perturbation = 0            # Random node displacement as a fraction of the module size; 0 = regular lattice.
seed         = 123          # Seed of the mesh perturbation (the random field has its own seed). Legacy: SEED.

[material]
law                 = "bilinear"   # Constitutive law of the bars.
young_modulus       = 3.87 GPa     # Young's modulus. Legacy: YNG.
poisson_ratio       = 0.25         # Poisson's ratio, from 0 up to less than 0.5. Legacy: PSN.
density             = 1500 kg/m3   # Mass density. Legacy: ROH.
fracture_energy     = 0.5 N/m      # Specific fracture energy. Legacy: GFR.
critical_distance   = 4.5 mm       # Equivalent (critical) distance. Legacy: DEQ.
failure_area_factor = 0.1385       # Fraction of the module face that fails per bar. Legacy: CAF.

[material.scatter]
type = "file"                                # Scatter of the critical strain: none, file (one multiplier per bar) or generated.
file = "../beam_102/arquivo_3lc_rnao_cv05"   # Text file with one multiplier per bar, relative to this file.

[time]
step     = 0.35 us   # Integration time step, or auto (0.9 times the critical step). Legacy: DT.
duration = 2.8 ms    # Total simulated time. Legacy: TTOT.

[damping]
type         = "mass_proportional"   # Damping model.
initial      = 2500 1/s              # Mass-proportional damping before switch_time. Legacy: DF1.
final        = 2500 1/s              # Mass-proportional damping after switch_time. Legacy: DF2.
switch_time  = 15 ms                 # Time at which the damping changes from initial to final. Legacy: TDAF.
constitutive = 0 s                   # Stiffness-proportional damping inside the bar law. Legacy: CON.

[scenario]
type          = "clamped_beam"   # Test case (see ldem.scenarios.registry); its other keys follow. Legacy: TEST.
force_rate    = 1000 N/s         # Property forceRate of ldem.scenarios.ClampedBeam.
ramp_time     = 0.35 ms          # Property rampTime of ldem.scenarios.ClampedBeam.
load_position = "midspan"        # Property loadPosition of ldem.scenarios.ClampedBeam.
load_height   = 0.5 modules      # Property loadHeight of ldem.scenarios.ClampedBeam.

[[monitor.node]]
name = "node_2441"   # Label of the node.
id   = 2441          # (x, y, z) = (4.5, 0.5, 24.5) modules

[[monitor.node]]
name = "node_884"   # Label of the node.
id   = 884          # (x, y, z) = (1, 3, 24) modules

[monitor.bar]
tracked = 14398   # Number of the bar whose strain history is stored at every step. Legacy: OU9.

[output]
folder = "output"   # Output folder, relative to the case file.
mat    = true       # Write results.mat.
ansys  = true       # Write ANSYS macro files (needs snapshots.every > 0).
vtk    = true       # Write VTK files for ParaView (needs snapshots.every > 0).

[output.snapshots]
every = 1000 steps   # Steps or time between full-field snapshots; 0 = never. Legacy: OU3.

[output.control_nodes]
every = 1 step   # Steps or time between records of the control nodes and reactions; 0 = never. Legacy: OU6.

[output.energy]
every = 1 step   # Steps or time between records of the energies; 0 = never. Legacy: OU8.
