msgstr ""

msgid "How several [[sweep]] blocks combine: all combinations (product) or one by one (zip)."
msgstr ""
"Como vários blocos [[sweep]] se combinam: todas as combinações (product) ou um a um "
"(zip)."

msgid "``module_size``"
msgstr ""

msgid "number + unit (m, cm, mm, um, km)"
msgstr "número + unidade (m, cm, mm, um, km)"

